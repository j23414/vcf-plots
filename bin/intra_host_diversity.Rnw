\section*{Minor Variants positions}

<<fig.width=8, fig.height=8>>=
# Libraries
library(tidyverse)
library(magrittr)
library(knitr)
library(kableExtra)
library(cowplot)
library(Biostrings)

# Load data
data <- readxl::read_excel("samples_variant_results_longer.xlsx")
head(data)

# Clean data
complete_data <- data %>%
  select(-IsSynonymous, -AltAminoAcid, -AltCodon, -IsTransition, -AminoAcidChange) %>% # Recompute these based on minor and major variant
  subset(VariantType == "SNP") %>%
  subset(Gene != "PB1-F2") %>%
  mutate(
    Percentage = as.numeric(Percentage),
    CHROM=factor(CHROM, 
                 levels=c("PV062510_PB2", "PV074323_PB1", "PV062508_PA", "PV062513_HA",
                          "PV062507_MP", "PV062511_NA", "PV062509_NP", "PV062512_NS"))
  ) %>% # Get all percentages of A,C,G,T at a position
  pivot_wider(
    names_from=ALT,
    values_from = Percentage
  ) %>%
  rowwise() %>%
  mutate( # Sum all percentages in case there are multiple variants at a position
    total=sum(C, A, G, T, na.rm=TRUE)
  )%>%
  ungroup() %>%
  mutate( # Compute the remaining reference percentage based on total
    A=case_when(REF=="A" ~ 1 - total, TRUE ~ A),
    C=case_when(REF=="C" ~ 1 - total, TRUE ~ C),
    G=case_when(REF=="G" ~ 1 - total, TRUE ~ G),
    T=case_when(REF=="T" ~ 1 - total, TRUE ~ T)
  ) %>%
  rowwise() %>%
  mutate( # Specify the major_variant nucleotide
    major_percentage=max(A,C,G,T, na.rm=TRUE),
    consensus=case_when(A==major_percentage ~ "A",
                        G==major_percentage ~ "G",
                        C==major_percentage ~ "C",
                        T==major_percentage ~ "T"),
    SNPCodonPosition = as.numeric(SNPCodonPosition),
    # TODO: Check the other codon positions in case they are in the variant list
    majorCodon =case_when(
      IsGenic ~ paste0(
        substr(RefCodon, 1, SNPCodonPosition),
        consensus,
        substr(RefCodon, SNPCodonPosition + 2, 3)
      ),
      TRUE ~ NA),
    majorAminoAcid = GENETIC_CODE[majorCodon]
  ) %>%
  ungroup()

# Expand back into longer format
expand_data <- complete_data %>%
  pivot_longer(
    cols=c(A,C,G,T),
    names_to = "variant",
    values_to = "minor_percentage"
  ) %>%
  subset(!is.na(minor_percentage)) %>%
  #subset(consensus != variant) %>%
  subset(minor_percentage !=0) %>%
  mutate(
    mutation = paste0(consensus,"->", variant, sep=""),
    minorCodon = case_when(
      IsGenic ~ paste0(
        substr(majorCodon, 1, SNPCodonPosition),
        variant,
        substr(majorCodon, SNPCodonPosition + 2, 3)
      ),
      TRUE ~ NA
    ),
    minorAminoAcid = GENETIC_CODE[minorCodon],
    IsSynonymous = case_when(
      is.na(majorAminoAcid) ~ "Intergenic",
      majorAminoAcid == minorAminoAcid ~ "Synonymous",
      TRUE ~ "Non-Synonymous"
    ), 
    flipped = consensus == REF # diagnostic
  ) %>%
  arrange(Sample)


# Plot minor variants along genome
ggplot(expand_data, aes(x=POS, y=minor_percentage, color=IsSynonymous)) +
  geom_point() +
  facet_wrap(~CHROM, ncol=1) +
  theme_bw() + 
  labs(
    x="Genomic position",
    y="iSNV frequency",
    color="Mutation type",
    title="Minor variants from all samples"
  )
@ 

<<echo=TRUE, eval=FALSE>>=
for (SAMPLE in unique(expand_data$Sample)){
  sample_data = expand_data %>%
    subset(Sample == SAMPLE)
  
  p <- sample_data %>%
    ggplot(aes(x=POS, y=minor_percentage, color=IsSynonymous)) +
    geom_point() +
    facet_wrap(~CHROM, ncol=1) +
    theme_bw()
    labs(
      x="Genomic position",
      y="iSNV frequency",
      color="Mutation type",
      title=paste0("Minor variants from ", SAMPLE)
    )
  ggsave(paste0("plots/", SAMPLE,"_genomeXvariant.png"), p,
         width=6, height=max(length(unique(sample_data$CHROM)), 2))
}
@

<<fig.width=6, fig.height=4>>=
sdata <- expand_data %>%
  group_by(CHROM, mutation, IsSynonymous) %>%
  summarize(n=n())

# Plot mutational spectrum
sdata %>%
  ggplot(aes(x = mutation, y = n, fill = IsSynonymous)) +
  geom_bar(stat="identity", position="stack") +
  facet_wrap(~CHROM, ncol=4) +
  theme_bw() +
  theme(
      axis.text.x = ggplot2::element_text(angle=90, vjust=1, hjust=1, size=6),
      legend.position = "right"
      ) +
  labs(
    fill="Mutation type",
    x="mutation",
    y="Number of iSNVs",
    title="Mutational spectrum in H1N1 samples"
  )
@

<<fig.width=6, fig.height=4>>=
sdata <- expand_data %>%
  mutate(
    iSNVfreq = case_when(minor_percentage <=0.15 ~ "[0.0 - 0.15",
                         minor_percentage <=0.27 ~ "(0.15 - 0.27]",
                         minor_percentage <=0.39 ~ "(0.27 - 0.39]",
                         TRUE ~ "(0.39 - 0.50]"),
    iSNVfreq = factor(iSNVfreq, levels=c("[0.0 - 0.15", "(0.15 - 0.27]", "(0.27 - 0.39]", "(0.39 - 0.50]"))
    
  ) %>%
  group_by(CHROM, iSNVfreq, IsSynonymous) %>%
  summarize(n=n())

# Plot iSNV frequency
sdata %>%
  ggplot(aes(x = iSNVfreq, y = n, fill = IsSynonymous)) +
  geom_bar(stat="identity", position="stack") +
  facet_wrap(~CHROM, ncol=4) +
  theme_bw()+
  theme(
      axis.text.x = ggplot2::element_text(angle=90, vjust=0.5, hjust=1, size=6),
      axis.title.x = ggplot2::element_blank(), axis.title.y=ggplot2::element_blank(),
      legend.position = "right"
      )
@

