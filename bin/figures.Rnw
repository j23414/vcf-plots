\section*{Intrahost diversity and mutational spectrum}

<<fig.width=4, fig.height=4>>=
minor_variants_data %>%
  # Count iSNV by Chromosome
  filter(
    minor_percentage > minimum_frequency
  ) %>%
  select(Sample, CHROM, POS) %>%
  unique(.) %>%
  group_by(Sample, CHROM) %>%
  summarize(
    n=n()
  )%>%
  ungroup(.) %>%
  mutate(
    n = case_when(grepl("PB2", CHROM) ~ n/2.3,
                  grepl("PB1", CHROM) ~ n/2.3,
                  grepl("PA", CHROM) ~ n/2.1,
                  grepl("HA", CHROM) ~ n/1.7,
                  grepl("NP", CHROM) ~ n/1.4,
                  grepl("NA", CHROM) ~ n/1.4,
                  grepl("MP", CHROM) ~ n/0.9,
                  grepl("NS", CHROM) ~ n/0.7)
  ) %>%
  # Boxplot by segment
  ggplot(., aes(x=factor(CHROM), y=n)) +
  geom_boxplot() +
  force_panelsizes(cols = c(5, 4, 3, 2)) +
  labs(y="Number of iSNVs / kb / sample", x="Segment") +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 90, vjust = 0.5,hjust = 1)
  )

ggsave(
  filename = "figs/boxplot_segments.png",
  create.dir = TRUE
)
@

Filtered to minor variants above \Sexpr{minimum_frequency}, and total count of iSNV normalized by segment length.

\newpage
\section*{iSNV frequencies}

<<fig.width=6, fig.height=4>>=
minor_variants_data_freq <- minor_variants_data %>%
  mutate(
    isnv_freq = case_when(
      minor_percentage > 0.40 ~ "(0.40, 0.50]",
      minor_percentage > 0.30 ~ "(0.30, 0.40]",
      minor_percentage > 0.20 ~ "(0.20, 0.30]",
      minor_percentage > 0.10 ~ "(0.10, 0.20]",
      minor_percentage > 0.01 ~ "(0.01, 0.10]",
      minor_percentage > 0.005 ~ "(0.005, 0.01]",
      TRUE ~ "(0.00, 0.005]"
    )
  )

isnv_freq_data <- minor_variants_data_freq %>%
  group_by(CHROM, IsSynonymous, isnv_freq) %>%
  summarize(
    n = n(),
    .groups = "drop"
  ) %>%
  complete(
    CHROM,
    IsSynonymous,
    isnv_freq,
    fill = list(n = 0)
  )

isnv_freq_data %>%
  ggplot(., aes(x=isnv_freq, y=n, fill=IsSynonymous)) +
  geom_bar(stat = "identity", position = 'dodge') +
  facet_wrap(~ CHROM, scale="free_y") +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 90, hjust=1, vjust=0.5)
  ) +
  labs(x="iSNV frequency", y="Frequency", title="All frequencies")

ggsave(
  filename = "figs/isnv_freq_all.png",
  create.dir = TRUE
)

isnv_freq_data %>%
  filter(isnv_freq != "(0.00, 0.005]") %>%
  ggplot(., aes(x=isnv_freq, y=n, fill=IsSynonymous)) +
  geom_bar(stat = "identity", position = 'dodge') +
  facet_wrap(~ CHROM, scale="free_y") +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 90, hjust=1, vjust=0.5)
  ) +
  labs(x="iSNV frequency", y="Frequency", title=paste0("Drop anything below ", minimum_frequency))

ggsave(
  filename = "figs/isnv_freq_above_min.png",
  create.dir = TRUE
)
@

\newpage
\section*{Mutational bias across different codons}

<<fig.width=8, fig.height=6>>==
codon_data <- minor_variants_data_freq %>%
  filter(
    minor_percentage > minimum_frequency,
    isnv_freq != "(0.00, 0.005]",
    VariantType == "SNP",
    majorCodon != "NA"
  )

codon_data %>%
  ggplot(., aes(x=majorCodon, fill=isnv_freq)) + geom_bar() + facet_wrap(~mutation, scale="free_x") +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle=90, hjust=1, vjust=0.5)
  )+
  labs(x = "Consensus codon", fill="iSNV Frequency")

ggsave(
  filename = "figs/mutational_bias.png",
  create.dir = TRUE
)
@

\newpage
\section*{Potential signatures of selection}

<<fig.width=7, fig.height=4>>==
shared_threshold = 7

c_data <- minor_variants_data %>%
  filter(
    VariantType == "SNP"
  ) %>%
  group_by(CHROM, POS, mutation, IsSynonymous, consensus, variant, majorAminoAcid, minorAminoAcid, CodonPosition) %>%
  summarise(
    n=n()
  ) %>%
  arrange(., desc(n)) %>%
  ungroup(.) %>%
  filter(n>1) %>%
  mutate(
    label_mut=paste0(consensus, POS, variant, sep="")
  )

c_data %>%
  ggplot(., aes(x=POS, y=n, color=IsSynonymous)) +
  geom_point() +
  geom_text_repel(
    data = \(df) filter(df, n > shared_threshold),
    aes(label = label_mut),
    show.legend = FALSE
  ) +
  theme_bw() +
  expand_limits(y=0) +
  facet_wrap(~CHROM) +
  labs(x="Genomic position", y="Shared", title="iSNV shared across how many samples")

ggsave(
  filename = "figs/shared_isnv_count.png",
  create.dir = TRUE
)
@

\section*{Frequency of shared non-synonymous iSNVs}

<<fig.width=8, fig.height=4>>==
shared_isnvs <- c_data %>%
  mutate(
    chrom_mut=paste0(CHROM,label_mut)
  ) %>%
  filter(
    n>shared_threshold
  ) %>%
  select(chrom_mut)

temp <- minor_variants_data %>%
  mutate(
    label_mut=paste0(consensus, POS, variant, sep="")
  ) %>%
  mutate(
    chrom_mut = paste0(CHROM, label_mut)
  ) %>%
  filter(chrom_mut %in% shared_isnvs$chrom_mut)

temp %>%
  ggplot(., aes(x=label_mut, y=minor_percentage, fill=IsSynonymous)) +
  geom_boxplot() +
  facet_wrap(~CHROM, scale="free") +
  expand_limits(y=0) +
theme( axis.text.x = element_text(angle = 90, hjust=1, vjust=0.5)) +
  labs(x="iSNV", y="Percentage",
       title=paste0("Frequency of iSNV shared across samples (n>", shared_threshold, ")"))

ggsave(
  filename = "figs/shared_isnv_count_freq.png",
  create.dir = TRUE
)

temp %>%
  filter(IsSynonymous =="Non-Synonymous") %>%
  mutate(
    label_aa_mut = paste0(majorAminoAcid, CodonPosition, minorAminoAcid)
  ) %>%
    ggplot(., aes(x=label_aa_mut, y=minor_percentage)) +
  geom_boxplot() +
  facet_wrap(~CHROM, scale="free") +
theme( axis.text.x = element_text(angle = 90, hjust=1, vjust=0.5)) +
  labs(x="Amino acid change", y="Percentage",
       title=paste0("Frequency of Non-Synonymous iSNV shared across samples (n>", shared_threshold, ")"))

ggsave(
  filename = "figs/shared_isnv_count_freq_nonsyn.png",
  create.dir = TRUE
)
@

<<fig.width=8, fig.height=5>>==
