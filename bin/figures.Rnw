<<echo=FALSE>>=
library(knitr)
opts_chunk$set(fig.width = 6, fig.height = 3.5, size = "footnotesize", fig.align = "center", cache = FALSE, echo = FALSE, warning=FALSE, message=FALSE)
@

<<fig.width=8, fig.height=4, echo=FALSE>>=
# Libraries
library(tidyverse)
library(DT)
library(Biostrings)
library(ggh4x)
library(pheatmap)
library(ggrepel)

# ============================================================
# DATA PROCESSING
# ============================================================

age_data <- read_delim("/Users/jchang99/github/j23414/vcf-plots/bin/S6_Age_and_DPI_metadata.csv", delim=",")
names(age_data) <- c("SJ", "months", "onset", "years")
age_data$SJ <- as.character(age_data$SJ)

chromosome_order = c("PV062510|PB2", "PV074323|PB1", "PV062508|PA", "PV062513|HA",
                       "PV062509|NP", "PV062511|NA", "PV062507|MP", "PV062512|NS")

INFILE="/Users/jchang99/github/j23414/vcf-plots/data/expand_data_100000_0100.tsv"
expand_data <- read_delim(INFILE, delim="\t", na=character()) %>%
  mutate(
    CHROM=factor(CHROM, levels=chromosome_order),
    SJ=str_split_i(Sample,"_", 2)
  ) %>%
  left_join(
    .,
    age_data,
    by="SJ"
  )

depth_data <- read_delim("/Users/jchang99/github/j23414/vcf-plots/data/combined_depth.tsv", delim = "\t", na = character()) %>%
  mutate(
    CHROM = factor(CHROM, levels = chromosome_order),
    Depth = case_when(Depth < 1 ~ 1, TRUE ~ Depth)
  )

filtered_depth_data <- read_delim("/Users/jchang99/github/j23414/vcf-plots/data/combined_depth2.tsv", delim = "\t", na = character()) %>%
  mutate(
    CHROM = factor(CHROM, levels = chromosome_order),
    Depth = case_when(Depth < 1 ~ 1, TRUE ~ Depth)
)

mindepth=100
@

\section*{Do we have sufficent depth and coverage to call variants?}

<<fig.width=8, fig.height=4>>=
depth_window <- 100
sample_num <- length(unique(filtered_depth_data$Sample))

filtered_depth_data %>%
  # Group by depth window
  unique(.) %>%
  mutate(
    group = floor(POS/depth_window)*depth_window
  ) %>%
  group_by(Sample, CHROM, group) %>%
  summarize(
    average_depth = mean(Depth, na.rm = TRUE)
  ) %>%
  ungroup(.) %>%
  # Plot
  ggplot(., aes(x=factor(group), y=average_depth)) +
  geom_boxplot() +
  scale_y_log10() +
  geom_hline(yintercept = 1000,
             linetype = "dashed",
             color = "red") +
  geom_hline(yintercept = 100,
             linetype = "dashed",
             color = "blue") +
  facet_wrap(~CHROM, scale="free_x", nrow=2, dir="v") +
  force_panelsizes(cols = c(5, 4, 3, 2)) +
  labs(y=paste0("Mean depth per ",depth_window,"bp window"), x="Genomic position",
       title=paste0("Read depth across genome (",sample_num," samples)")
  ) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 90, vjust = 0.5,hjust = 1)
  )

ggsave(
  filename = "figs/all_samples_depth.png",
  create.dir = TRUE
)
@

\noindent
The red line shows a cutoff DP of 1000 while the blue line shows a cutoff DP of 100. \newline This report is generated from datafile: \Sexpr{gsub("_", "\\\\_", INFILE)}

\section*{Intrahost diversity}

<<fig.width=8>>=
# Keep variants within the frequency range of interest
minimum_frequency = 0.005

# Only minor variants
minor_variants_data <- expand_data %>%
  filter(
    minor_percentage < 0.5
  )

# Count and normalize iSNV per sample and segment
isnv_normalized <- minor_variants_data %>%
  # Count iSNVs
  filter(
    minor_percentage > minimum_frequency,
  ) %>%
  distinct(Sample, CHROM, mutation) %>%
  count(Sample, CHROM, name = "n_isnv") %>%
  # Normalize iSNV counts
  complete(
    Sample,
    CHROM,
    fill = list(n_isnv = 0)
  ) %>%
  mutate(
    isnv_per_kb = case_when(
        grepl("PB2", CHROM) ~ n_isnv/2.3,
        grepl("PB1", CHROM) ~ n_isnv/2.3,
        grepl("PA", CHROM) ~ n_isnv/2.1,
        grepl("HA", CHROM) ~ n_isnv/1.7,
        grepl("NP", CHROM) ~ n_isnv/1.4,
        grepl("NA", CHROM) ~ n_isnv/1.4,
        grepl("MP", CHROM) ~ n_isnv/0.9,
        grepl("NS", CHROM) ~ n_isnv/0.7)
  )

heatmap_data <- isnv_normalized %>%
  select(CHROM, Sample, isnv_per_kb) %>%
  pivot_wider(
    names_from = Sample,
    values_from = isnv_per_kb,
    values_fill = 0
  )

heatmap_matrix <- heatmap_data %>%
  column_to_rownames("CHROM") %>%
  as.matrix()

heatmap_colors <- colorRampPalette(c("#FFFF99", "#FDBB45", "#C45A91", "#5E3C80", "#333333"))(100)

unique_age <- expand_data %>%
  select(Sample, years, onset) %>%
  unique(.)

sample_annotation <- data.frame(
  Age = unique_age$years,
  Onset = unique_age$onset
)

rownames(sample_annotation) <- unique_age$Sample
sample_annotation <- sample_annotation[colnames(heatmap_matrix), , drop = FALSE]
annotation_colors <- list(
  Age = colorRampPalette(c("lightblue", "yellow", "red"))(100),
  Onset = colorRampPalette(c("lightgreen", "yellow", "orange"))(100)
)

pheatmap(
  heatmap_matrix,
  color = heatmap_colors,
  cluster_rows = FALSE,
  cluster_cols = TRUE,
  clustering_distance_cols = "euclidean",
  clustering_method = "complete",
  border_color = "grey90",
  angle_col = 90,
  main = "iSNV counts per kb by sample and segment",
  legend_breaks = c(0, 1, 2, 3.0),
  fontsize_row = 10,
  fontsize_col = 8,
  annotation_col = sample_annotation,
  annotation_colors = annotation_colors
)

ggsave(
  filename = "figs/heatmap.png",
  create.dir = TRUE
)
@

\noindent
Filtered to minor variants above \Sexpr{minimum_frequency}, and samples grouped by total count of iSNV (not shared iSNVs) and normalized by segment length.
Segments PB2 and PA seem to have the most iSNV called per 1000 bp region

